<?php

use Tackle\Evals\EvalCase;
use Tackle\Evals\Probe;

/*
 * ai:eval case — benchmark the coding agent against a seeded bug.
 *
 * Return an EvalCase (or an array of them). ai:eval seeds `files` into an
 * isolated directory, hands the agent `prompt`, then runs `grader` against the
 * result. As generated this case is a working example (the agent should fix
 * it) — replace the bug, prompt, and grader with your own. Keep it small,
 * pure, and unambiguous so grading stays deterministic.
 * Run it with: php artisan ai:eval --case={{ id }}
 */

return new EvalCase(
    id: '{{ id }}',
    title: '{{ title }}',
    category: 'bug',
    files: [
        // The buggy code the agent must fix. Give the class a distinctive name
        // so it never collides with another case.
        '{{ class }}.php' => <<<'PHP'
        <?php

        class {{ class }}
        {
            // BUG: should return double the value, but returns it unchanged.
            public function compute(int $value): int
            {
                return $value;
            }
        }
        PHP,
    ],
    // A concrete, fix-oriented instruction — say what's wrong and what "fixed"
    // looks like. (Vague prompts get vague results.)
    prompt: '{{ class }}::compute() in {{ class }}.php should return double its input, but it returns the input unchanged. Fix compute() so it doubles the value.',

    // The grader runs in a subprocess that requires the (possibly fixed) file.
    // Set $target (the bug is fixed) and $happy (a previously-correct behaviour
    // still holds — this catches a "fix" that regresses something else).
    grader: Probe::subprocess('{{ class }}.php', '
        $subject = new {{ class }}();
        $target = $subject->compute(2) === 4;   // the behaviour being fixed
        $happy  = $subject->compute(0) === 0;   // a happy path that must still hold
    '),
);
